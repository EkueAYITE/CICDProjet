# Copiez ce fichier en .env pour configurer Docker (ne pas commiter .env)
# cp .env.docker.example .env

# Votre nom d'utilisateur Docker Hub (ex: monuser)
# L'image sera : monuser/cicd-api:1.0.0
DOCKER_HUB_USERNAME=votre-username

# Tag de l'image (par défaut: version du package.json)
IMAGE_TAG=1.0.0

# Port exposé localement
PORT=3000

# Pour pousser sur Docker Hub : docker login puis docker-compose push
